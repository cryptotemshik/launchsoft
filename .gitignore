node_modules/
dist/
*.local
.DS_Store

# Headless snipe runner — never commit real keys or a live config.
snipe.keys
snipe.config.json
# State the server keeps beside the config: the watchlist, the drop index, the
# pending queue and the audit log. The queue carries endpoint URLs, and on a
# paid plan a URL is the API key.
snipe.config.json.*
snipe.env
*.keys
!*.keys.example
# The public address book and the signer socket are runtime state beside the
# config. The book holds only addresses, but it is still per-box state.
*.addresses.json
*.signer.sock
# A key file named something else is still a key file. The runner takes the
# name from `keysFile`, so nothing stops someone calling it keys.txt.
keys.txt
*.privatekeys

# Per-account worlds (accounts.ts): every account's config, keys, billing,
# watchlist and the registry of who exists. Runtime state, never committed.
data/
registry.json
