{
  "name": "launchpad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "One-click NFT drop launcher for Robinhood Chain (SeaDrop-compatible, OpenSea-indexed)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "snipe": "tsx src/cli/snipe.ts",
    "snipe:server": "tsx src/cli/server.ts",
    "rpc:bench": "tsx src/cli/bench.ts",
    "deploy:cf": "npm run build && npx -y wrangler pages deploy"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.59.0",
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.19",
    "wagmi": "^2.12.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
